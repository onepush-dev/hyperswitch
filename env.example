# Template expressions for every variable, per service.
# ${{secret(N, "...")}} values are generated per deploy by Railway.

# ── hyperswitch-router ──────────────────────────────────────────────
PORT=8080
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}
PGDATABASE=${{Postgres.PGDATABASE}}
ROUTER__REDIS__HOST=${{Redis.REDISHOST}}
ROUTER__REDIS__PORT=${{Redis.REDISPORT}}
ROUTER__REDIS__USERNAME=${{Redis.REDISUSER}}
ROUTER__REDIS__PASSWORD=${{Redis.REDISPASSWORD}}
ROUTER__SECRETS__ADMIN_API_KEY=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
ROUTER__SECRETS__JWT_SECRET=${{secret(48, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
ROUTER__SECRETS__MASTER_ENC_KEY=${{secret(64, "abcdef0123456789")}}
ROUTER__API_KEYS__HASH_KEY=${{secret(64, "abcdef0123456789")}}
ROUTER__USER_AUTH_METHODS__ENCRYPTION_KEY=${{secret(64, "abcdef0123456789")}}
ROUTER__INTERNAL_MERCHANT_ID_PROFILE_ID_AUTH__INTERNAL_API_KEY=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
ROUTER__PAYMENT_METHOD_AUTH__PM_AUTH_KEY=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
ROUTER__USER__BASE_URL=https://${{control-center.RAILWAY_PUBLIC_DOMAIN}}
ROUTER__MULTITENANCY__TENANTS__PUBLIC__BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
ROUTER__MULTITENANCY__TENANTS__PUBLIC__USER__CONTROL_CENTER_URL=https://${{control-center.RAILWAY_PUBLIC_DOMAIN}}
ROUTER__SERVER__WORKERS=2
ROUTER__LOG__CONSOLE__LEVEL=INFO

# ── control-center ──────────────────────────────────────────────────
PORT=9000
default__endpoints__api_url=https://${{hyperswitch-router.RAILWAY_PUBLIC_DOMAIN}}
default__features__email=false
default__features__totp=true

# ── Postgres (Railway Postgres defaults) ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=railway
POSTGRES_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")}}
PGDATA=/var/lib/postgresql/data/pgdata
PGHOST=${{RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432
PGUSER=${{POSTGRES_USER}}
PGPASSWORD=${{POSTGRES_PASSWORD}}
PGDATABASE=${{POSTGRES_DB}}
DATABASE_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
SSL_CERT_DAYS=820

# ── Redis (Railway Redis defaults) ──────────────────────────────────
REDIS_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")}}
REDISHOST=${{RAILWAY_PRIVATE_DOMAIN}}
REDISPORT=6379
REDISUSER=default
REDISPASSWORD=${{REDIS_PASSWORD}}
REDIS_URL=redis://${{REDISUSER}}:${{REDIS_PASSWORD}}@${{REDISHOST}}:${{REDISPORT}}
